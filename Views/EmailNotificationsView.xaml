<UserControl x:Class="CruzNeryClinic.Views.EmailNotificationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#D8DFEA"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#223357"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,16,0,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}"/>
        <Style x:Key="NotificationCell" TargetType="DataGridCell" BasedOn="{StaticResource DashboardDataGridCellStyle}">
            <Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF0F9"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="NotificationHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DashboardDataGridColumnHeaderStyle}">
            <Setter Property="Padding" Value="10,10"/><Setter Property="Foreground" Value="#223357"/>
            <Setter Property="Background" Value="#F1F5F9"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#F5F6F8">
        <Grid Margin="30">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
                <StackPanel><TextBlock Text="Email Notifications" FontSize="28" FontWeight="Bold" Foreground="#223357"/>
                    <TextBlock Text="Appointment updates and digital receipts" Foreground="#64748B" Margin="0,6,0,0" FontSize="14"/>
                </StackPanel>
                <Button Content="Gmail settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource Action}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding CanConfigure, Converter={StaticResource VisibleWhenTrue}}"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel><TextBlock Text="{Binding SenderStatus}" FontWeight="SemiBold" Foreground="#223357" TextWrapping="Wrap"/>
                    <TextBlock Text="The sending computer needs internet access. Messages remain queued when offline." Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,16">
                        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Action}"/>
                            <Button Content="Retry failed" Command="{Binding RetryCommand}" Style="{StaticResource Action}"/>
                            <Button Content="Send pending" Command="{Binding SendPendingCommand}" Style="{StaticResource Action}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,12,0"/>
                    </DockPanel>
                    <DataGrid x:Name="NotificationGrid" Grid.Row="1" ItemsSource="{Binding Notifications}" SelectedItem="{Binding Selected}"
                        Style="{StaticResource DashboardDataGridStyle}" CellStyle="{StaticResource NotificationCell}" ColumnHeaderStyle="{StaticResource NotificationHeader}"
                        IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                        HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="44" BorderBrush="#E2E8F0" BorderThickness="1"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="140">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*" MinWidth="130"/>
                            <DataGridTextColumn Header="Email address" Binding="{Binding Recipient}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Notification" Binding="{Binding KindDisplay}" Width="180"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtDisplay}" Width="185"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" IsHitTestVisible="False">
                        <TextBlock Text="No email notifications yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#223357"/>
                        <TextBlock Text="Add a patient email address and confirm email authorization.&#10;Scheduling an appointment or recording a payment will create a notification."
                            TextAlignment="Center" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="6" Padding="14" Margin="0,16,0,0" DataContext="{Binding Selected}">
                        <StackPanel><TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="#223357" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Details}" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Expander Header="View message" Margin="0,10,0,0"><ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding Payload.Body}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </ScrollViewer></Expander>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#223357" Margin="0,14,0,0"/>
        </Grid>
        <Grid Background="#99000000" Visibility="{Binding IsSettingsOpen, Converter={StaticResource VisibleWhenTrue}}">
            <Border Style="{StaticResource Card}" Width="520" MaxHeight="720" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Gmail settings" FontSize="22" FontWeight="Bold" Foreground="#223357"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><StackPanel>
                    <TextBlock Text="Enable 2-Step Verification on the clinic Gmail account, then generate an app password in Google Account settings." TextWrapping="Wrap" Foreground="#64748B" Margin="0,10,0,0"/>
                    <TextBlock Text="Clinic Gmail address" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SenderEmailInput" Text="{Binding SenderEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                    <TextBlock Text="Sender name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SenderNameInput" Text="{Binding SenderName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                    <TextBlock Text="Gmail app password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="GmailPassword" Height="42" Padding="10" PasswordChanged="GmailPasswordChanged" IsVisibleChanged="GmailPasswordVisibilityChanged"/>
                    <TextBlock Text="Use the 16-letter app password. Leave blank to keep this account's saved password. It is protected on this Windows account." TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock Text="Send appointment reminders this many hours before the visit" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                    <ComboBox Height="42" ItemsSource="{Binding ReminderHourOptions}" SelectedItem="{Binding ReminderHours}"/>
                    <CheckBox IsChecked="{Binding Enabled}" Margin="0,20,0,8"><TextBlock Text="Enable Gmail delivery from this computer" TextWrapping="Wrap"/></CheckBox>
                    <TextBlock Text="{Binding ThisComputer, StringFormat='Sending computer: {0}'}" Foreground="#64748B"/>
                    <TextBlock Text="Keep the clinic app open on this computer for automatic delivery and reminders. Saving designates this computer as the sender for the shared clinic database." Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel></ScrollViewer>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Command="{Binding CloseSettingsCommand}" Style="{StaticResource Action}"/>
                        <Button x:Name="SaveGmailSettingsButton" Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Action}"/>
                    </StackPanel>
                </StackPanel></Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
