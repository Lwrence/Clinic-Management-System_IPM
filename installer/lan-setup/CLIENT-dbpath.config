# Put this file on the CLIENT laptop at:
#   %LocalAppData%\CruzNeryClinic\dbpath.config
# (rename it to exactly  dbpath.config  -- remove the "CLIENT-" part)
#
# This tells the CLIENT app to use the SERVER's shared database over the network.
# IMPORTANT: replace the IP below with the SERVER laptop's actual IP address
# (run ipconfig on the SERVER while both are on the hotspot).
# "ClinicDB" is the share name created when you shared the C:\ClinicDB folder.
# Lines starting with # are ignored.
\\192.168.254.105\ClinicDB\cruz_nery_clinic.db
